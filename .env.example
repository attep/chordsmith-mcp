# Copy this file to .env and fill in the values before running docker compose.

# --- Option A: docker-compose.yml (Caddy, needs a domain with DNS pointing here) ---

# The domain your server will be reachable at (Caddy obtains an HTTPS certificate
# for it automatically).
DOMAIN=chordsmith.example.com

# --- Option B: docker-compose.tunnel.yml (Cloudflare Tunnel, no open ports) ---

# Token of the tunnel you created in the Cloudflare dashboard
# (Zero Trust -> Networks -> Tunnels), with a Public Hostname -> http://chordsmith:8000.
# CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token
# The exact public hostname of that tunnel (used for OAuth metadata and redirects).
# CHORDSMITH_PUBLIC_URL=https://chordsmith.example.com

# --- Both options ---

# The password you type on the ChordSmith sign-in page. Use a long random string,
# e.g. the output of: python -c "import secrets; print(secrets.token_urlsafe(24))"
CHORDSMITH_AUTH_PASSWORD=change-me-to-a-long-random-passphrase
